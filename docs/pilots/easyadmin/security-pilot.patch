From 7137118a38396b9722b53c1b8cc498e827b5475c Mon Sep 17 00:00:00 2001
From: root <root@moodle-dev.fritz.box>
Date: Tue, 6 Oct 2026 09:21:31 +0200
Subject: [PATCH] Add security regression pilot for backup access and account
 retention

---
 .github/workflows/moodle-ci.yml |   9 +-
 tests/security_test.php         | 140 ++++++++++++++++++++++++++++++++
 2 files changed, 147 insertions(+), 2 deletions(-)
 create mode 100644 tests/security_test.php

diff --git a/.github/workflows/moodle-ci.yml b/.github/workflows/moodle-ci.yml
index a45102c..fa6a127 100644
--- a/.github/workflows/moodle-ci.yml
+++ b/.github/workflows/moodle-ci.yml
@@ -6,8 +6,8 @@
 # Ablage: .github/workflows/moodle-ci.yml
 #
 # Angepasst: templates/ (Mustache) ist vorhanden, daher mit Mustache-Schritt.
-# Kein amd/, daher ohne Grunt-Schritt. Kein tests/, daher ohne phpunit- und
-# behat-Schritt.
+# Kein amd/, daher ohne Grunt-Schritt. Sicherheits-PHPUnit vorhanden;
+# keine Behat-Szenarien.
 ##############################################################################
 
 name: Moodle Plugin CI
@@ -16,6 +16,7 @@ on:
   push:
     branches:
       - main
+      - test/security-pilot-easyadmin
   pull_request:
   workflow_dispatch:
 
@@ -119,3 +120,7 @@ jobs:
       - name: Mustache-Templates pruefen
         if: ${{ !cancelled() }}
         run: moodle-plugin-ci mustache
+
+      - name: Sicherheitsregressionstests
+        if: ${{ !cancelled() }}
+        run: moodle-plugin-ci phpunit --fail-on-warning
diff --git a/tests/security_test.php b/tests/security_test.php
new file mode 100644
index 0000000..355338d
--- /dev/null
+++ b/tests/security_test.php
@@ -0,0 +1,140 @@
